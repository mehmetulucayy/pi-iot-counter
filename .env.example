# Firebase Configuration (Optional)
# If you want to use Firebase for cloud synchronization, fill in these values
# Otherwise, the system will work with local SQLite database only

# Enable/Disable Firebase (true/false)
ENABLE_FIREBASE=false

# Firebase Database URL (if enabled)
# Example: https://your-project-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=

# Firebase Credentials File Path (if enabled)
# Place your firebase service account JSON file and specify its name
FIREBASE_CREDENTIALS_FILE=firebase_credentials.json
